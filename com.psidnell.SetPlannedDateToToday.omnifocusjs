//Forked from "identifier": "com.patrick.SetPlannedDateToToday",
/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.SetPlannedDateToToday",
    "version": "1.0",
    "description": "Toggle a planned date of today",
    "label": "Plan for Today",
    "mediumLabel": "Plan for Today",
    "longLabel": "Toggle a planned date of today",
    "paletteLabel": "Plan for Today",
    "image": "signpost.right"
}*/
(() => {
  const action = new PlugIn.Action(selection => {
    // 1. Fetch the default time string (e.g. "08:00" or "00:00:00")
    let timeString = settings.objectForKey('DefaultPlannedTime') || "00:00:00";
    const parts = timeString.split(":").map(Number);
    const [h = 0, m = 0, s = 0] = parts;

    // 2. Construct “today at default time”
    const cal = Calendar.current;
    const todayStart = cal.startOfDay(new Date());
    const dc = new DateComponents();
    dc.hour   = h;
    dc.minute = m;
    dc.second = s;
    const today = cal.dateByAddingDateComponents(todayStart, dc);

    // 3. Apply to every selected task

    var numSet = 0;

    selection.tasks.forEach(task => {
      if (task.plannedDate) {
        numSet++;
      }
    });


    if (numSet != selection.tasks.length) {
        selection.tasks.forEach(task => {
          task.plannedDate = today;
        });
    } else {
        selection.tasks.forEach(task => {
          task.plannedDate = null;
        });
    }
  });


  action.validate = function(selection, sender){
      return selection.tasks.length > 0;
  };

  return action;
})();