/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.SetRandomDefer",
    "version": "1.0",
    "description": "Set a Random Defer Date",
    "label": "Rnd Defer",
    "mediumLabel": "Rnd Defer",
    "longLabel": "Set a Random Defer Date",
    "paletteLabel": "Rnd Defer",
    "image": "dice"
}*/
(() => {
  const action = new PlugIn.Action(selection => {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    selection.tasks.forEach(task => {
      const deferDate = task.effectiveDeferDate  && task.effectiveDeferDate.getTime() > today.getTime() ?
        task.effectiveDeferDate : today;

      const minDays = 3;
      const maxDays = 31;
      const randomDays = minDays + Math.floor(Math.random() * (maxDays - minDays));

      deferDate.setDate(deferDate.getDate() + randomDays);
      task.deferDate = deferDate;
    });
  });

  action.validate = (selection, sender) => selection.tasks.length >= 1;

  return action;
})();
