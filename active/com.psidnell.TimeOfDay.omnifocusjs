/*{
    "author": "Paul Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.TimeOfDay",
    "version": "1.0",
    "description": "Add Time Of Day Tags",
    "label": "Time",
    "mediumLabel": "Time",
    "longLabel": "Add Time Of Day Tags",
    "paletteLabel": "Add Time Of Day Tags",
    "image": "clock.badge.checkmark"
}*/
(() => {

    const action = new PlugIn.Action(function(selection, sender){

        //console.log('Running');

        var allDayTag = flattenedTags.byName("CALENDAR") || new Tag("CALENDAR");
        var amTag = flattenedTags.byName("AM") || new Tag("AM");
        var pmTag = flattenedTags.byName("PM") || new Tag("PM");
        var eveningTag = flattenedTags.byName("EVENING") || new Tag("EVENING");

        selection.tasks.forEach(task => {
            const taskDate = task.dueDate;

            if (!!taskDate) {

                //console.log('Candidate:', task.name, !!taskDate);

                var hour = taskDate.getHours();
                var minute = taskDate.getMinutes();

                var newTag;
                if (hour < 12) {
                   newTag = amTag;
                } else if (hour < 18) {
                    newTag = pmTag;
                } else if (hour < 23 || (hour === 23 && minute < 59)) {
                    newTag = eveningTag;
                } else {
                    newTag = allDayTag;
                }

                task.addTag(newTag);

                // console.log('Set tag:', newTag.name);
            }
        });
        //console.log ('Finished');
	});

	action.validate = function(selection, sender){
		return (selection.tasks.length > 0);
	};

	return action;
})();

