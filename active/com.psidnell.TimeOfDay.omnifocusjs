/*{
    "author": "Paul Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.TimeOfDay",
    "version": "1.0",
    "description": "Add Time Of Day Tags",
    "label": "Time",
    "mediumLabel": "Time",
    "longLabel": "Add Time Of Day Tags",
    "paletteLabel": "Add Time Of Day Tags",
    "image": "clock.badge.checkmark"
}*/
(() => {

    const action = new PlugIn.Action(function(selection, sender){

        //console.log('Running');

        const today = new Date();

        var allDayTag = flattenedTags.byName("CALENDAR") || new Tag("CALENDAR");
        var earlyTag = flattenedTags.byName("EARLY") || new Tag("EARLY");
        var amTag = flattenedTags.byName("AM") || new Tag("AM");
        var pmTag = flattenedTags.byName("PM") || new Tag("PM");
        var eveningTag = flattenedTags.byName("EVENING") || new Tag("EVENING");

        let tasks = selection.tasks;
        if (tasks.length === 0) {
            tasks = flattenedTasks.filter(task => {
                return !!task.effectiveDueDate &&
                       task.effectiveDueDate.getFullYear() === today.getFullYear() &&
                       task.effectiveDueDate.getMonth() === today.getMonth() &&
                       task.effectiveDueDate.getDate() === today.getDate() &&
                       (task.taskStatus === Task.Status.Available ||
                       task.taskStatus === Task.Status.Next ||
                       task.taskStatus === Task.Status.DueSoon ||
                       task.taskStatus === Task.Status.Overdue)
            });
            // console.log('Available:', tasks.length);
        }

        tasks.forEach(task => {
            const taskDate = task.effectiveDueDate;

            if (!!taskDate) {

                //console.log('Candidate:', task.name, !!taskDate);

                var hour = taskDate.getHours();
                var minute = taskDate.getMinutes();

                var newTag;
                if (hour < 9) {
                    newTag = earlyTag;
                } else if (hour < 12) {
                   newTag = amTag;
                } else if (hour < 18) {
                    newTag = pmTag;
                } else if (hour < 23 || (hour === 23 && minute < 59)) {
                    newTag = eveningTag;
                } else {
                    newTag = allDayTag;
                }

                task.addTag(newTag);

                // console.log('Set tag:', newTag.name);
            }
        });
        //console.log ('Finished');
	});

	action.validate = function(selection, sender){
		return true;
	};

	return action;
})();

