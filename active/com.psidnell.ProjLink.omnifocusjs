/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.ProjLink",
    "version": "1.0",
    "description": "Create a link task for the project",
    "label": "Project Link",
    "mediumLabel": "DProject Link",
    "longLabel": "Project Link",
    "paletteLabel": "Project Link",
    "image": "link.badge.plus"
}*/
(() => {
    const action = new PlugIn.Action((selection, sender) => {
        var project;
        if (selection.tasks.length == 1) {
            var task = selection.tasks[0];
            if (!task.containingProject) {
                return;
            }
            project = task.containingProject;
        } else {
            project = selection.projects[0];
        }

        var title = '(@) ' + project.name;
        var noteLines = [];
        noteLines.push(project.name + ': omnifocus:///project/' +
                project.id.primaryKey);
        noteLines.push('');
        var note = noteLines.join('\n');

        var newTask = new Task(title, inbox.beginning);
        if (project) {
            moveTasks([newTask], project);
        }

        newTask.addTag(Tag.forecastTag);
        newTask.flagged = true;
        newTask.note = note;
    });

    action.validate = (selection, sender) => {
        return selection.tasks.length == 1 || selection.projects.length == 1
    };

    return action;
})();
