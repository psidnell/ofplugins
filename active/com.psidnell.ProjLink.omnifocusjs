/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.ProjLink",
    "version": "1.0",
    "description": "Create a link task for the project",
    "label": "Link",
    "mediumLabel": "Project Link",
    "longLabel": "Project Link",
    "paletteLabel": "Project Link",
    "image": "link.badge.plus"
}*/
(() => {
    const action = new PlugIn.Action((selection, sender) => {

        var currentPerspective = document.windows[0].perspective;

        var projectForNewTask = null;
        if (selection.tasks.length === 1) {
            var task = selection.tasks[0];
            // Null if in the inbox
            projectForNewTask = task.containingProject;
        } else {
            projectForNewTask = selection.projects[0];
        }

        var link;
        var name;
        if (currentPerspective.name === 'Inbox') {
            // Link to the inbox
            name = currentPerspective.name;
            link = 'omnifocus:///inbox/';
        } else if (currentPerspective.name === 'Projects' || currentPerspective.name === 'Tags') {
            // Link to the project
            // Could link to selected tag, folder etc - but could be complicated
            name = projectForNewTask.name;
            link = 'omnifocus:///project/' +projectForNewTask.id.primaryKey;
        } else {
            // Link to the perspective
            name = currentPerspective.name;
            link = 'omnifocus:///perspective/' + currentPerspective.identifier;
        }


        var title = '(@) ' + name;
        var noteLines = [];
        noteLines.push(link);
        noteLines.push('');
        var note = noteLines.join('\n');

        var newTask = new Task(title, inbox.beginning);
        if (projectForNewTask) {
            moveTasks([newTask], projectForNewTask);
        }

        newTask.addTag(Tag.forecastTag);
        newTask.flagged = true;
        newTask.note = note;
    });

    action.validate = (selection, sender) => {
        return selection.tasks.length == 1 || selection.projects.length == 1
    };

    return action;
})();
