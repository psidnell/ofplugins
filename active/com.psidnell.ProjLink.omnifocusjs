/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.ProjLink",
    "version": "1.0",
    "description": "Create a link task for the project",
    "label": "Link",
    "mediumLabel": "Project Link",
    "longLabel": "Project Link",
    "paletteLabel": "Project Link",
    "image": "link.badge.plus"
}*/
(() => {

    function inboxLink () {
        return ['Inbox', 'omnifocus:///inbox/', null];
    }

    function taskLink (task) {
        let project = task.containingProject;
        if ((!!project)) {
            return projectLink(project);
        } else {
            return [null, null, null];
        }
    }

    function projectLink (project) {
        return [project.name, 'omnifocus:///project/' + project.id.primaryKey, project];
    }

    function folderLink (folder) {
        return [folder.name, 'omnifocus:///folder/' + folder.id.primaryKey, null];
    }

    function tagLink (tag) {
        return [tag.name, 'omnifocus:///tag/' + tag.id.primaryKey, null];
    }

    function perspectiveLink (perspective) {
        return [perspective.name, 'omnifocus:///perspective/' + perspective.identifier, null];
    }

    const action = new PlugIn.Action((selection, sender) => {

        let task = selection.tasks.length === 1 ? selection.tasks[0] : null;
        let project = selection.projects.length === 1 ? selection.projects[0] : null;
        let folder = selection.folders.length === 1 ? selection.folders[0] : null;
        let tag = selection.tags.length === 1 ? selection.tags[0] : null;
        let currentPerspective = document.windows[0].perspective;

        // console.log("Current perspective", currentPerspective.name);


        let link = null;
        let name = null;
        let projectForNewTask = null;
        // Go through the different things that might have been selected
        if (currentPerspective.name === 'Inbox') {
            [name, link, projectForNewTask] = inboxLink();
        } else if (!!task) {
            [name, link, projectForNewTask] = taskLink(task);
        } else if (!!project) {
            [name, link, projectForNewTask] = projectLink(project);
        } else if (!!folder) {
            [name, link, projectForNewTask] = folderLink(folder);
        } else if (!!tag) {
            [name, link, projectForNewTask] = tagLink(tag);
        } else if (!!currentPerspective) {
            [name, link, projectForNewTask] = perspectiveLink(currentPerspective);
        }

        if (!name || !link) {
            return;
        }

        var title = '(@) ' + name;
        var noteLines = [];
        noteLines.push(link);
        noteLines.push('');
        var note = noteLines.join('\n');

        var newTask = new Task(title, inbox.beginning);
        if (projectForNewTask) {
            moveTasks([newTask], projectForNewTask);
        }

        newTask.addTag(Tag.forecastTag);
        newTask.flagged = true;
        newTask.note = note;
    });

    action.validate = (selection, sender) => {
        // Selected: One of something, or nothing
        return (
                selection.tasks.length === 1 &&
                selection.projects.length === 0 &&
                selection.folders.length === 0 &&
                selection.tags.length === 0
            ) || (
                selection.tasks.length === 0 &&
                selection.projects.length === 1 &&
                selection.folders.length === 0 &&
                selection.tags.length === 0
            ) || (
                selection.tasks.length === 0 &&
                selection.projects.length === 0 &&
                selection.folders.length === 1 &&
                selection.tags.length === 0
            ) || (
                selection.tasks.length === 0 &&
                selection.projects.length === 0 &&
                selection.folders.length === 0 &&
                selection.tags.length === 1
            ) || (
                selection.tasks.length === 0 &&
                selection.projects.length === 0 &&
                selection.folders.length === 0 &&
                selection.tags.length === 0
            );
    };

    return action;
})();
