/*{
    "author": "Paul Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.Sort",
    "version": "1.0",
    "description": "Smart Sort",
    "label": "Sort",
    "mediumLabel": "Sort",
    "longLabel": "Smart Sort",
    "paletteLabel": "Smart Sort",
    "image": "arrow.up.arrow.down"
}*/
(() => {

    var smartTime = (item) => {
        var time;
        if (item.dueDate) {
            time = item.dueDate.getTime()
        } else if (item.plannedDate) {
            time = item.plannedDate.getTime();
        } else if (item.deferDate) {
            time = item.deferDate.getTime();}
        else {
            time = item.added.getTime();
        }

        // console.log ('smartTime ' + item.name + ' ' + new Date(time) + ' = ' + time);
        return time;
    }

    var isRemaining = (item) => {
        // If it's in an available state
        var status = item.taskStatus;
        switch (status) {
            case Task.Status.Overdue:
            case Task.Status.DueSoon:
            case Task.Status.Available:
            case Task.Status.Next:
            case Task.Status.Blocked:
                // console.log(item.name + ' Remaining ' + item.taskStatus);
                return true;
        }

        // console.log(item.name + ' Done ' + item.taskStatus);
        return false;
    }

    var hasOnHoldTag = (item) => {
        for (let i = 0; i < item.tags.length; i++) {
            let tag = item.tags[i];
            if (tag.status === Tag.Status.OnHold) {
                // console.log(item.name + ' ON HOLD ' + tag.name);
                return true;
            }
        }
        // console.log(item.name + ' NOT ON HOLD');
        return false;
    }

	var compare = (left, right) => {

        // Compare on isRemaining
        const leftIsRemaining = isRemaining(left);
        const rightIsRemaining = isRemaining(right);
        if (leftIsRemaining !== rightIsRemaining) {
            if (leftIsRemaining) {
                return -1;
            } else {
                return 1;
            }
        }

        // Compare on having an on hold tag
        const leftHasOnHold = hasOnHoldTag(left);
        const rightHasOnHold= hasOnHoldTag(right);
        if (leftHasOnHold !== rightHasOnHold) {
            if (leftHasOnHold) {
                return 1;
            } else {
                return -1;
            }
        }

        // Compare on flagged
        const leftIsFlagged = left.flagged;
        const rightIsFlagged= right.flagged;
        if (leftIsFlagged !== rightIsFlagged) {
            if (leftIsFlagged) {
                return -1;
            } else {
                return 1;
            }
        }

        // Compare having a due
        const leftHasDue = !!left.dueDate;
        const rightHasDue= !!right.dueDate;
        if (leftHasDue !== rightHasDue) {
            if (leftHasDue) {
                return -1;
            } else {
                return 1;
            }
        }

        // Compare having a planned
        const leftHasPlanned = !!left.plannedDate;
        const rightHasPlanned= !!right.plannedDate;
        if (leftHasPlanned !== rightHasPlanned) {
            if (leftHasPlanned) {
                return -1;
            } else {
                return 1;
            }
        }

        // Don't compare on having a defer

        // Compare on smart times (any date on the task)
        const leftSmartTime = smartTime(left);
        const rightSmartTime = smartTime(right);
        if (leftSmartTime !== rightSmartTime) {
            return leftSmartTime - rightSmartTime;
        }

        // Unlikely to get here...

		// Fallback: Compare on id
        return left.id.primaryKey.localeCompare(right.id.primaryKey);
	};

	const action = new PlugIn.Action(function(selection, sender){
		project = selection.projects.length == 1 ?
            selection.projects[0] :
            selection.tasks[0].containingProject;

        // Need to select the project (if a task was selected)
        // otherwise the sorted project doesn't redraw
        document.windows[0].selectObjects([project]);

		var tasks = [];
		for (var i = 0; i < project.task.children.length; i++) {
			tasks.push(project.task.children[i]);
		}
		tasks.sort(compare);
		moveTasks(tasks, project);
	});

	action.validate = function(selection, sender){
		return (
            selection.projects.length === 1 ||
            (selection.tasks.length === 1 && selection.tasks[0].containingProject != null)
        );
	};

	return action;
})();
