/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.CalendarSync",
    "version": "1.0",
    "description": "Synchronise Calendar",
    "label": "CalendarSync",
    "mediumLabel": "Synchronise Calendar",
    "longLabel": "Synchronise Calendar",
    "paletteLabel": "Synchronise Calendar",
    "image": "calendar"
}*/
(() => {
    const action = new PlugIn.Action((selection, sender) => {
        // Extract data passed in from Dictionary
        let d = argument.input;
        let title = d.Title;
        let startDate = new Date(d.StartDate);
        let endDate = new Date(d.EndDate);
        let isAllDay = d.IsAllDay;
        let notes = d.Notes;
        let shortId = d.ShortId;
        let calendar = d.Calendar;
        let formattedStartTime = d.FormattedStartTime;
        let formattedStartDate = d.FormattedStartDate;
        let formattedEndTime = d.FormattedEndTime;
        let url = d.URL;
        let location = d.Location;
        let formattedEndDate = d.FormattedEndDate;
        let id = d.Id;
        let formattedNow = d.FormattedNow;
        let calendarDate = d.CalendarDate;

        let deferDate = null;
        let plannedDate = null;
        let dueDate = null;
        let create = false;
        let dateCase = '';
        let calendarProject = flattenedProjects.byName('#Calendar');

        let shownDate = '';

        console.log('Parameters', JSON.stringify(d));

        //----------------------------

        // Handle the date cases



        if (startDate.getFullYear() == endDate.getFullYear() &&
            startDate.getMonth() == endDate.getMonth() &&
            startDate.getDate() == endDate.getDate() &&
            !isAllDay) {

            // 1. Start & end on same day, not all day

            shownDate = formattedStartTime + ' ' + formattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());

            create = true;
            dateCase = 1;
        } else if ((startDate.getFullYear() != endDate.getFullYear() ||
                startDate.getMonth() != endDate.getMonth() ||
                startDate.getDate() != endDate.getDate()) &&
            !isAllDay) {

            // 2. Start & end on different days, not all day

            shownDate = formattedStartTime + ' ' + formattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());

            create = true;
            dateCase = 2;
        } else if (startDate.getFullYear() == endDate.getFullYear() ||
            startDate.getMonth() == endDate.getMonth() ||
            startDate.getDate() == endDate.getDate() &&
            isAllDay) {

            // 3. All day single day

            shownDate = formattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());
            dueDate.setHours(23);
            dueDate.setMinutes(59);

            create = true;
            dateCase = 3;
        } else if ((startDate.getFullYear() != endDate.getFullYear() ||
                startDate.getMonth() != endDate.getMonth() ||
                startDate.getDate() != endDate.getDate()) &&
            isAllDay) {

            // 4. All day multi day

            shownDate = formattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());
            dueDate.setHours(23);
            dueDate.setMinutes(59);

            create = true;
            dateCase = 4;
        } else {
            // ???
            dateCase = 5;
            create = true;
        }


        if (create) {

            // Create the task


            task = new Task(title + ' | ' + shownDate + ' (' + shortId + ')', calendarProject);
            task.deferDate = deferDate;;
            task.plannedDate = plannedDate;
            task.dueDate = dueDate;
            task.flagged = true;

            // The Note



            task.note = `
Calendar: ${calendar}
Start:  ${formattedStartTime} ${formattedStartDate}
End: ${formattedEndTime} ${formattedEndDate}
Is All Day: ${isAllDay}
ID: ${id}
Added: ${formattedNow}
Open Calendar: shortcuts://run-shortcut?name=Open%20Calendar%20On%20Date&input=${calendarDate}
Case: ${dateCase}
`


            if (url && url.length > 0) {
                task.note += '\nURL: ' + url;
            }


            if (location && location.length > 0) {
                task.note += '\n\nLocation:\n' + location;
            }

            if (notes.length > 0) {
                task.note += '\n\nNotes:\n' + notes;
            }

        }

    });

    action.validate = (selection, sender) => {
        return true;
    };

    return action;
})();