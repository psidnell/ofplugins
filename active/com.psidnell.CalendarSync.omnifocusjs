/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.CalendarSync",
    "version": "1.0",
    "description": "Synchronise Calendar",
    "label": "CalendarSync",
    "mediumLabel": "Synchronise Calendar",
    "longLabel": "Synchronise Calendar",
    "paletteLabel": "Synchronise Calendar",
    "image": "calendar"
}*/
(() => {
    const action = new PlugIn.Action((selection, sender) => {
        let d = argument.input;
        let startDate = new Date(d.StartDate);
        let endDate = new Date(d.EndDate);
        let notes = d.Notes;
        let deferDate = null;
        let plannedDate = null;
        let dueDate = null;
        let create = false;
        let dateCase = '';
        let calendarProject = flattenedProjects.byName(d.CalendarProjectName);
        let shownDate = '';

        console.log('Parameters', JSON.stringify(d));

        //----------------------------

        // Handle the date cases

        if (startDate.getFullYear() == endDate.getFullYear() &&
            startDate.getMonth() == endDate.getMonth() &&
            startDate.getDate() == endDate.getDate() &&
            !d.IsAllDay) {

            // 1. Start & end on same day, not all day

            shownDate = d.FormattedStartTime + ' ' + d.FormattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());

            create = true;
            dateCase = 1;
        } else if ((startDate.getFullYear() != endDate.getFullYear() ||
                startDate.getMonth() != endDate.getMonth() ||
                startDate.getDate() != endDate.getDate()) &&
            !d.IsAllDay) {

            // 2. Start & end on different days, not all day

            shownDate = d.FormattedStartTime + ' ' + d.FormattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());

            create = true;
            dateCase = 2;
        } else if (startDate.getFullYear() == endDate.getFullYear() ||
            startDate.getMonth() == endDate.getMonth() ||
            startDate.getDate() == endDate.getDate() &&
            d.IsAllDay) {

            // 3. All day single day

            shownDate = d.FormattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());
            dueDate.setHours(23);
            dueDate.setMinutes(59);

            create = true;
            dateCase = 3;
        } else if ((startDate.getFullYear() != endDate.getFullYear() ||
                startDate.getMonth() != endDate.getMonth() ||
                startDate.getDate() != endDate.getDate()) &&
            d.IsAllDay) {

            // 4. All day multi day

            shownDate = d.FormattedStartDate;

            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);

            dueDate = new Date(startDate.getTime());
            dueDate.setHours(23);
            dueDate.setMinutes(59);

            create = true;
            dateCase = 4;
        } else {
            // ???
            dateCase = 5;
            create = true;
        }


        if (create) {

            // Create the task
            task = new Task(d.Title + ' | ' + shownDate + ' (' + d.ShortId + ')', calendarProject);
            task.deferDate = deferDate;;
            task.plannedDate = plannedDate;
            task.dueDate = dueDate;
            task.flagged = true;

            // The Note
            task.note = `
Calendar: ${d.Calendar}
Start:  ${d.FormattedStartTime} ${d.FormattedStartDate}
End: ${d.FormattedEndTime} ${d.FormattedEndDate}
Is All Day: ${d.IsAllDay}
ID: ${d.Id}
Added: ${d.FormattedNow}
Open Calendar: shortcuts://run-shortcut?name=Open%20Calendar%20On%20Date&input=${d.CalendarDate}
Case: ${dateCase}
`

            if (d.URL && d.URL.length > 0) {
                task.note += '\nURL: ' + d.URL;
            }

            if (d.Location && d.Location.length > 0) {
                task.note += '\n\nLocation:\n' + d.Location;
            }

            if (notes.length > 0) {
                task.note += '\n\nNotes:\n' + notes;
            }

        }

    });

    action.validate = (selection, sender) => {
        return true;
    };

    return action;
})();