/*{
    "author": "P. Sidnell",
    "targets": ["omnifocus"],
    "type": "action",
    "identifier": "com.psidnell.CalendarSync",
    "version": "1.0",
    "description": "Synchronise Calendar",
    "label": "CalendarSync",
    "mediumLabel": "Synchronise Calendar",
    "longLabel": "Synchronise Calendar",
    "paletteLabel": "Synchronise Calendar",
    "image": "calendar"
}*/
(() => {

    function padNumber (n, size) {
        str = n.toString();
        while (str.length < size) {
            str = '0' + str;
        }
        return str;
    }

    function formatDate(date) {
        return padNumber(date.getFullYear(), 4) + '-' +
            padNumber(1 + date.getMonth(), 2) + '-' +
            padNumber(date.getDate(), 2);
    }

    function formatDOW(date) {
        return date.toLocaleDateString('en-uk', { weekday: 'short' });
    }

    function formatTime(date) {
        return padNumber(date.getHours(), 2) + ':' +
            padNumber(date.getMinutes(), 2);
    }

    function formatDateTime(date) {
        return formatTime(date) + ' ' + formatDOW(date) + ' ' + formatDate(date);
    }

    function isTimedSingleDayEvent(startDate, endDate, isAllDay) {
        return !isAllDay &&
            startDate.getFullYear() == endDate.getFullYear() &&
            startDate.getMonth() == endDate.getMonth() &&
            startDate.getDate() == endDate.getDate();
    }

    function isTimedMultiDayEvent(startDate, endDate, isAllDay) {
        return !isAllDay && (
            startDate.getFullYear() != endDate.getFullYear() ||
            startDate.getMonth() != endDate.getMonth() ||
            startDate.getDate() != endDate.getDate()
        );
    }

    function isAllDaySingleDayEvent(startDate, endDate, isAllDay) {
        return isAllDay &&
            startDate.getFullYear() == endDate.getFullYear() &&
            startDate.getMonth() == endDate.getMonth() &&
            startDate.getDate() == endDate.getDate();
    }

    function isAllDayMultiDayEvent(startDate, endDate, isAllDay) {
        return isAllDay && (
            startDate.getFullYear() != endDate.getFullYear() ||
            startDate.getMonth() != endDate.getMonth() ||
            startDate.getDate() != endDate.getDate()
        );
    }

    function createTask(title, shownDate, shortId, calendarProject, deferDate, plannedDate,
                        dueDate, calendar, startDate, endDate, isAllDay, id, formattedNow,
                        calendarDate, dateCase, url, location, notes) {
        //console.log("Creating", title, 'Case ' + case);

        task = new Task(title + ' | ' + shownDate + ' (' + shortId + ')', calendarProject);
        task.deferDate = deferDate;
        task.plannedDate = plannedDate;
        task.dueDate = dueDate;
        task.flagged = true;
        task.note = `
CreationData:
- Calendar: ${calendar}
- Start:  ${formatDateTime(startDate)}
- End: ${formatDateTime(endDate)}
- Is All Day: ${isAllDay}
- ID: ${id}
- Added: ${formattedNow}
- Calendar Day: shortcuts://run-shortcut?name=Open%20Calendar%20On%20Date&input=${calendarDate}
- Case: ${dateCase}
`

        if (url && url.length > 0) {
            task.note += '\n\nURL: ' + url;
        }

        if (location && location.length > 0) {
            task.note += '\n\nLocation:\n' + location;
        }

        if (notes.length > 0) {
            task.note += '\n\n' + notes;
        }
    }

    const action = new PlugIn.Action((selection, sender) => {
        // Extract data passed in from Dictionary in Apple Shortcut
        const {
            title,
            id,
            isAllDay,
            notes,
            shortId,
            calendar,
            url,
            location,
            startDateISO8601,
            endDateISO8601
        } = argument.input;

        const startDate = new Date(startDateISO8601);
        const endDate = new Date(endDateISO8601);
        const calendarDate = formatDate(startDate);
        let deferDate = null;

        let calendarProject = flattenedProjects.byName('#Calendar');
        let shownDate = '';
        let formattedNow = formatDateTime(new Date());

        //console.log('Parameters', JSON.stringify(d));

        if (isTimedSingleDayEvent(startDate, endDate, isAllDay)) {
            let dateCase = 1;
            shownDate = formatDateTime(startDate);
            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);
            let plannedDate = null;
            let dueDate = new Date(startDate.getTime());
            createTask(title, shownDate, shortId, calendarProject, deferDate, plannedDate,
                dueDate, calendar, startDate, endDate, isAllDay, id, formattedNow,
                calendarDate, dateCase, url, location, notes);
        } else if (isTimedMultiDayEvent(startDate, endDate, isAllDay)) {
            let dateCase = 2;
            shownDate = formatDateTime(startDate);
            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);
            let plannedDate = null;
            let dueDate = new Date(startDate.getTime());
            createTask(title, shownDate, shortId, calendarProject, deferDate, plannedDate,
                dueDate, calendar, startDate, endDate, isAllDay, id, formattedNow,
                calendarDate, dateCase, url, location, notes);
        } else if (isAllDaySingleDayEvent(startDate, endDate, isAllDay)) {
            console.log(3, startDate, endDate, isAllDay)
            let dateCase = 3;
            shownDate = formatDate(startDate);
            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);
            let plannedDate = null;
            let dueDate = new Date(startDate.getTime());
            dueDate.setHours(23);
            dueDate.setMinutes(59);
            createTask(title, shownDate, shortId, calendarProject, deferDate, plannedDate,
                dueDate, calendar, startDate, endDate, isAllDay, id, formattedNow,
                calendarDate, dateCase, url, location, notes);

        } else if (isAllDayMultiDayEvent(startDate, endDate, isAllDay)) {
            let dateCase = 4;
            shownDate = formatDate(startDate);
            deferDate = new Date(startDate.getTime());
            deferDate.setHours(0);
            deferDate.setMinutes(0);
            let plannedDate = null;
            let dueDate = new Date(startDate.getTime());
            dueDate.setHours(23);
            dueDate.setMinutes(59);
            createTask(title, shownDate, shortId, calendarProject, deferDate, plannedDate,
                dueDate, calendar, startDate, endDate, isAllDay, id, formattedNow,
                calendarDate, dateCase, url, location, notes);
        }
    });

    action.validate = (selection, sender) => {
        return true;
    };

    return action;
})();